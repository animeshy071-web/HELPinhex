---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CommandK from '../components/CommandK.astro';
import { getSearchDocs, getTermMap } from '../lib/load';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'HELPINhex — everything tech, decoded for beginners',
  description = 'Ask what you want to make → get the tools, the steps and the path. Every AI model, tool and platform explained in plain English — always fresh, always beginner-first.',
} = Astro.props;

const docs = getSearchDocs();
const terms = getTermMap();

// Prevent "</script>" breakouts in JSON islands:
const jsonSafe = (v: unknown) => JSON.stringify(v).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0a0e16" />
    <!-- Typography: Satoshi (body) + Clash Display (headings) via Fontshare -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&f[]=clash-display@500,600,700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Apply saved theme before first paint (no flash):
      try {
        document.documentElement.dataset.theme = localStorage.getItem('hx:theme') || 'light';
      } catch (e) {}
    </script>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"><i></i></div>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <CommandK />
    <script type="application/json" id="hx-docs" set:html={jsonSafe(docs)} />
    <script type="application/json" id="hx-terms" set:html={jsonSafe(terms)} />

    <script>
      // ===== HELPINhex base client layer (bundled once) =====
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      // 1. Theme toggle (icon visibility handled by CSS via data-theme)
      const themeBtn = document.querySelector('[data-theme-toggle]');
      const applyTheme = (t: string) => {
        document.documentElement.dataset.theme = t;
        if (themeBtn) themeBtn.setAttribute('aria-label', t === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
      };
      applyTheme(document.documentElement.dataset.theme || 'light');
      themeBtn?.addEventListener('click', () => {
        const t = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        try { localStorage.setItem('hx:theme', t); } catch (e) {}
        applyTheme(t);
      });

      // 2. Active nav link
      const path = location.pathname;
      for (const a of document.querySelectorAll<HTMLAnchorElement>('.nav-links a')) {
        const href = a.getAttribute('href') || '';
        if ((href === '/' && path === '/') || (href !== '/' && path.startsWith(href))) a.classList.add('active');
      }

      // 3. Streak/activity log (any interaction counts)
      function markDay() {
        try {
          const days: string[] = JSON.parse(localStorage.getItem('hx:days') || '[]');
          const d = new Date().toISOString().slice(0, 10);
          if (!days.includes(d)) {
            days.push(d);
            localStorage.setItem('hx:days', JSON.stringify(days.slice(-120)));
          }
        } catch (e) {}
      }

      // 4. Jargon decoder — hover tooltips built from #hx-terms
      let tip: HTMLDivElement | null = null;
      function ensureTip(): HTMLDivElement {
        if (!tip) {
          tip = document.createElement('div');
          tip.className = 'hx-tip';
          document.body.appendChild(tip);
        }
        return tip;
      }
      let termsMap: Record<string, { word: string; plain: string }> = {};
      try {
        termsMap = JSON.parse(document.getElementById('hx-terms')?.textContent || '{}');
      } catch (e) {}
      document.addEventListener('mouseover', (e) => {
        const el = (e.target as HTMLElement).closest('.term');
        if (!el) return;
        const t = termsMap[el.getAttribute('data-term') || ''];
        if (!t) return;
        const tipEl = ensureTip();
        const AMP = String.fromCharCode(38);
        tipEl.innerHTML = '<strong>' + t.word + '</strong><br>' + t.plain;
        const r = el.getBoundingClientRect();
        tipEl.style.opacity = '1';
        const tw = tipEl.offsetWidth || 280;
        let left = Math.min(Math.max(8, r.left), window.innerWidth - tw - 8);
        let top = r.bottom + 8;
        if (top + 120 > window.innerHeight) top = Math.max(8, r.top - 130);
        tipEl.style.left = left + 'px';
        tipEl.style.top = top + 'px';
      });
      document.addEventListener('mouseout', (e) => {
        if ((e.target as HTMLElement).closest('.term') && tip) tip.style.opacity = '0';
      });

      // 5. My Kit buttons (bookmarks) — one listener for the whole site
      document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('[data-kit]');
        if (!btn) return;
        const id = btn.getAttribute('data-kit') || '';
        let kit: string[] = [];
        try { kit = JSON.parse(localStorage.getItem('hx:kit') || '[]'); } catch (err) {}
        const i = kit.indexOf(id);
        if (i >= 0) {
          kit.splice(i, 1);
          btn.textContent = '\uFF0B Save to My Kit';
          btn.classList.remove('in-kit');
        } else {
          kit.push(id);
          btn.textContent = '\u2713 In My Kit';
          btn.classList.add('in-kit');
          markDay();
        }
        try { localStorage.setItem('hx:kit', JSON.stringify(kit)); } catch (err) {}
      });
      // reflect saved kit state on load
      try {
        const kit: string[] = JSON.parse(localStorage.getItem('hx:kit') || '[]');
        for (const b of document.querySelectorAll('[data-kit]')) {
          if (kit.includes(b.getAttribute('data-kit') || '')) {
            b.textContent = '\u2713 In My Kit';
            b.classList.add('in-kit');
          }
        }
      } catch (e) {}

      // 6. Service worker (PWA + offline)
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }

      // 7. Motion engine — Lenis smooth scroll + GSAP ScrollTrigger.
      //    Page scripts can grab the shared instances via window.__hx
      //    (e.g. __hx.gsap.to('.card', { y: 0, opacity: 1, scrollTrigger: {...} })).
      gsap.registerPlugin(ScrollTrigger);
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const lenis = reduceMotion ? null : new Lenis({ autoRaf: false });
      if (lenis) {
        lenis.on('scroll', ScrollTrigger.update);
        gsap.ticker.add((time) => lenis.raf(time * 1000));
        gsap.ticker.lagSmoothing(0);
      }
      (window as unknown as { __hx: unknown }).__hx = { gsap, ScrollTrigger, lenis };

      // 8. Scroll progress bar (top of viewport, works with or without Lenis)
      const progress = document.querySelector<HTMLElement>('.scroll-progress i');
      if (progress) {
        const setProgress = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          progress.style.transform = `scaleX(${max > 0 ? h.scrollTop / max : 0})`;
        };
        setProgress();
        window.addEventListener('scroll', setProgress, { passive: true });
      }

      // 9. Hero choreography — runs once, only where a .hero exists
      if (!reduceMotion && document.querySelector('.hero')) {
        gsap
          .timeline({ defaults: { ease: 'power3.out' } })
          .from('.hero h1', { y: 30, opacity: 0, filter: 'blur(10px)', duration: 0.9 }, 0.05)
          .from('.hero-sub', { y: 18, opacity: 0, duration: 0.7 }, 0.2)
          .from('.hero-cta', { y: 14, opacity: 0, duration: 0.55 }, 0.32)
          .from('.hero .ask-wrap', { y: 16, opacity: 0, duration: 0.6 }, 0.4)
          .from('.hero-stats .stat', { y: 12, opacity: 0, duration: 0.5, stagger: 0.08 }, 0.5)
          .from('.hero-ticker', { opacity: 0, duration: 0.9 }, 0.6);
      }

      // 10. Scroll reveals — opt-in via [data-reveal] (no-JS safe: nothing is hidden in CSS)
      if (!reduceMotion) {
        gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
          gsap.from(el, {
            y: 26,
            opacity: 0,
            duration: 0.75,
            ease: 'power3.out',
            delay: parseFloat(el.dataset.revealDelay || '0'),
            scrollTrigger: { trigger: el, start: 'top 88%', once: true },
          });
        });
      }
    </script>
  </body>
</html>
