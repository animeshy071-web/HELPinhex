---
import Badge from './Badge.astro';
import { Hexagon, ExternalLink } from '@lucide/astro';
---

<footer class="footer">
  <div class="container">
    <div class="footer-inner">
      <div style="display:flex; align-items:center; gap:0.5rem;">
        <span class="brand-mark" style="width:24px; height:24px; border-radius:7px;">
          <Hexagon size={13} strokeWidth={2.4} />
        </span>
        <span><strong>HELPINhex</strong> — "help in hex." Everything tech, decoded for beginners.</span>
      </div>
      <div class="small" style="display:flex; align-items:center; gap:0.45rem;">
        MIT licensed ·
        <a href="https://github.com/animeshy071-web/HELPinhex" target="_blank" rel="noopener" style="display:inline-flex; align-items:center; gap:0.35rem;">
          <ExternalLink size={15} /> GitHub
        </a>
        · freshness engine: <Badge tone="accent">live</Badge>
      </div>
    </div>
    <div class="small" style="margin-top:1rem; display:flex; flex-wrap:wrap; gap:0.4rem 1.1rem;">
      <a href="/compare/">Compare</a>
      <a href="/checker/">Laptop checker</a>
      <a href="/repos/">Repo Radar</a>
      <a href="/events/">Events</a>
      <a href="/opportunities/">Opportunities</a>
      <a href="/playground/">Playground</a>
      <a href="/prompts/">Prompts</a>
      <a href="/collections/">Collections</a>
      <a href="/calculator/">Calculator</a>
      <a href="/graveyard/">Graveyard</a>
      <a href="/glossary/">Glossary</a>
    </div>
  </div>
</footer>
