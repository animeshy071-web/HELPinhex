---
import { Hexagon, Sun, Moon } from '@lucide/astro';
---

<header class="nav">
  <div class="container nav-inner">
    <a class="brand" href="/">
      <span class="brand-mark"><Hexagon size={17} strokeWidth={2.4} /></span>
      <span>HELPinhex</span>
    </a>
    <nav class="nav-links" aria-label="Main">
      <a href="/today/">Today</a>
      <a href="/ask/">Ask</a>
      <a href="/chat/">Chat</a>
      <a href="/catalog/">Catalog</a>
      <a href="/repos/">Repos</a>
      <a href="/paths/">Paths</a>
      <a href="/guides/">Guides</a>
      <a href="/glossary/">Glossary</a>
      <a href="/me/">Me</a>
    </nav>
    <button class="theme-btn" data-theme-toggle title="Toggle light/dark theme">
      <Sun class="icon-sun" size={17} strokeWidth={2} />
      <Moon class="icon-moon" size={17} strokeWidth={2} />
    </button>
  </div>
</header>
