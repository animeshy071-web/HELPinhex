---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import { getEvents } from '../lib/load';

const events = getEvents();
const fetched = events ? new Date(events.fetchedAt).toLocaleString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : null;

// Hand-verified portals — the honest fallback (and starting point) until the auto-feed returns.
const portals = [
  {
    name: 'MLH (Major League Hacking)',
    url: 'https://mlh.io',
    who: 'The biggest student hackathon org — beginner-friendly, in-person + online seasons worldwide.',
    howto: 'Browse the season calendar, filter to online/near you, register as a solo beginner. They help form teams on the day.',
  },
  {
    name: 'Devpost',
    url: 'https://devpost.com/hackathons',
    who: 'The default home of online hackathons run by companies (with prizes) — thousands every year.',
    howto: 'Filter by "open for entries" + "online". Join one with a low entry bar; submissions are usually just a demo video + README.',
  },
  {
    name: 'Unstop',
    url: 'https://unstop.com',
    who: 'Big in India — hackathons, case competitions, hiring challenges, college events.',
    howto: 'Search hackathons open now, sort by soonest deadline. The online rounds are perfect first events.',
  },
  {
    name: 'Devfolio',
    url: 'https://devfolio.co',
    who: 'Major Indian hackathon platform — big online events with serious community energy.',
    howto: 'Watch the "happening now" list; registration windows are short, so check weekly.',
  },
  {
    name: 'Hack Club',
    url: 'https://hackathons.hackclub.com',
    who: 'High-schooler run, extremely beginner friendly, wholesome by design.',
    howto: 'If you are (or know) a high-schooler — this is the gentlest possible entry into hackathons.',
  },
];
---

<Base title="Events — hackathons & competitions · HELPINhex" description="Where to find hackathons and tech events as a beginner, plus the honest guide to actually finishing one.">
  <section class="section">
    <div class="container">
      <div class="section-head">
        <h1 style="font-size:2.2rem">Events</h1>
        {fetched && <Badge tone="accent">auto-feed: {fetched}</Badge>}
      </div>
      <p class="muted">
        Hackathons are the fastest way for a beginner to go from "I did a tutorial" to "I shipped something."
        The trick isn't winning — it's entering. These are the hand-verified places to find them.
      </p>

      {
        events && events.items.length > 0 && (
          <div class="card mt-2">
            <h3>Auto-caught listings</h3>
            <ul class="small" style="padding-left:1.1rem">
              {events.items.slice(0, 10).map((e) => (
                <li style="margin-bottom:0.5rem">
                  <a href={e.url} target="_blank" rel="noopener">{e.title}</a>
                  <span class="muted"> · {e.when ? new Date(e.when).toLocaleDateString() : 'dates on page'} · {e.location}</span>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <h2 class="mt-3">Where to look (verified portals)</h2>
      <div class="grid">
        {
          portals.map((p) => (
            <a class="card hover" href={p.url} target="_blank" rel="noopener">
              <h3 style="margin-top:0">{p.name}</h3>
              <p class="muted small" style="margin:0.25rem 0">{p.who}</p>
              <p class="small" style="margin:0.5rem 0 0"><strong>How to start:</strong> {p.howto}</p>
            </a>
          ))
        }
      </div>

      <blockquote class="mt-3">
        <strong>Your first hackathon — the realistic plan:</strong> pick an online one with a low entry bar →
        pick a boring, finishable idea (a working ugly thing beats an ambitious broken thing) →
        sleep at least once → submit <em>anything</em> before the deadline. Whether you win is irrelevant;
        you'll leave with a demo, a story, and proof you can finish. Then come back and read
        <a href="/paths/">the learning paths</a> to keep the momentum.
      </blockquote>

      <p class="muted small mt-2">
        <Badge tone="warn">honesty badge</Badge>
        We list portals, not scraped "top events" — deadlines and prizes change too fast to cache. Click through for the live truth.
        Auto-listings appear above when the events feed cooperates.
      </p>
    </div>
  </section>
</Base>
