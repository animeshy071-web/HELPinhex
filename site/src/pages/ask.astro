---
import Base from '../layouts/Base.astro';
import AskBox from '../components/AskBox.astro';
import Badge from '../components/Badge.astro';
import { getWorkflows, getTerms } from '../lib/load';
import { linkTerms } from '../lib/format';

const workflows = getWorkflows();
const terms = getTerms();
---

<Base title="Ask HELPINhex — get a sequenced plan, not links" description="Describe what you want to make. Get the tools, the order, the costs and the beginner mistakes — in one answer.">
  <section class="section">
    <div class="container">
      <h1 style="font-size:2.2rem">Ask for a <span style="background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent">plan</span>, not links.</h1>
      <p class="muted">
        Instant mode matches your question against our verified workflow library — deterministic, offline, no AI needed.
        <span class="badge accent" style="margin-left:0.35rem">live now</span>
        <span class="muted small"> · Ask HEX+ (AI-composed answers) arrives in Phase 4</span>
      </p>
      <div class="mt-3">
        <AskBox />
      </div>
    </div>
  </section>

  <section class="section" id="library">
    <div class="container">
      <div class="section-head">
        <h2>The workflow library</h2>
        <span class="muted small">{workflows.length} verified workflows · grows weekly</span>
      </div>
      {
        workflows.map((w) => (
          <div class="card mb-2" id={w.id}>
            <div class="result-head">
              <h3 style="margin:0">{w.title}</h3>
              <Badge tone="ok">{w.totalCost}</Badge>
              <Badge tone="violet">{w.totalTime}</Badge>
            </div>
            <table class="steps-table">
              <thead><tr><th>#</th><th>Step</th><th>Tool</th><th>Cost</th><th>Time</th></tr></thead>
              <tbody>
                {w.steps.map((s, i) => (
                  <tr>
                    <td class="step-n">{i + 1}</td>
                    <td><strong>{s.title}</strong><br /><span class="muted small" set:html={linkTerms(s.how, terms)} /></td>
                    <td class="small">{s.tool}</td>
                    <td class="small mono">{s.cost}</td>
                    <td class="small">{s.time}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <details>
              <summary class="muted" style="cursor:pointer">Common beginner mistakes</summary>
              <ul class="muted small">{w.mistakes.map((m) => <li set:html={linkTerms(m, terms)} />)}</ul>
            </details>
          </div>
        ))
      }
    </div>
  </section>
</Base>
