---
import Base from '../layouts/Base.astro';
import Badge from '../components/Badge.astro';
import fs from 'node:fs';
import path from 'node:path';
import { getTerms } from '../lib/load';
import { linkTerms } from '../lib/format';

interface Opportunity {
  id: string;
  title: string;
  what: string;
  firstStep: string;
  difficulty: number;
  timeToFirst: string;
  honestNote: string;
  links: string[];
}

const contentDir = path.resolve(process.cwd(), '..', 'content');
const opportunities: Opportunity[] = JSON.parse(fs.readFileSync(path.join(contentDir, 'opportunities.json'), 'utf8'));
const terms = getTerms();

const diff = (n: number) => '▮'.repeat(n) + '▯'.repeat(5 - n);
---

<Base title="Opportunities — real ways to earn with AI · HELPINhex" description="Honest money-making paths with AI: what each one really takes, what the first step is, and the warning nobody puts in the course ad.">
  <section class="section">
    <div class="container">
      <h1 style="font-size:2.2rem">Opportunities</h1>
      <p class="muted" set:html={linkTerms('Every "make money with AI" list promises passive income in your sleep. Here is the honest version: real paths, real difficulty ratings, real first steps — and the warning each one actually comes with.', terms)} />

      <div class="grid wide mt-3">
        {
          opportunities.map((o) => (
            <div class="card">
              <h3 style="margin-top:0">{o.title}</h3>
              <p class="small" set:html={linkTerms(o.what, terms)} />
              <p class="small" style="margin-bottom:0.4rem"><strong>First step:</strong> <span set:html={linkTerms(o.firstStep, terms)} /></p>
              <div class="chips">
                <Badge>difficulty {diff(o.difficulty)}</Badge>
                <Badge tone="violet">first results: {o.timeToFirst}</Badge>
              </div>
              <p class="muted small" style="margin:0.6rem 0 0">⚠️ {o.honestNote}</p>
              {
                o.links.length > 0 && (
                  <p class="small" style="margin:0.6rem 0 0">
                    {o.links.map((l, i) => (
                      <>
                        {i > 0 && ' · '}
                        <a href={l} target="_blank" rel="noopener">{new URL(l).hostname.replace('www.', '')}</a>
                      </>
                    ))}
                  </p>
                )
              }
            </div>
          ))
        }
      </div>

      <blockquote class="mt-3">
        <strong>The universal warning:</strong> anything that promises fast, effortless, or passive money is selling <em>you</em> as the product
        (course, group, "mentorship"). Every path above rewards the same boring thing: a small thing shipped, repeated, in public.
        Which is exactly what the <a href="/paths/">learning paths</a> train.
      </blockquote>
    </div>
  </section>
</Base>
